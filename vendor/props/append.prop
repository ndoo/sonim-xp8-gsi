ro.telephony.sim_slots.count=2
ro.com.android.dataroaming=false

# Stock A10 user build: adb authorization, no adb root
ro.adb.secure=1
ro.debuggable=0
persist.sys.usb.config=none

# Report the stock model (Sonim XP8800) instead of the GSI's product values
ro.product.property_source_order=vendor,odm,product,system_ext,system

# A/B OTA: update_engine copies these from the running slot when a payload omits them
ro.vendor.build.ab_ota_partitions=boot,system,vendor

# 2: repo-owned device files are on system (build-system.sh stage xp8).
# 3: also, flash.sh wrote slot b's firmware with this image; ota.json needs it.
ro.vendor.xp8.layout=3
