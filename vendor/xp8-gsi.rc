# Installed as /system/etc/init/xp8-gsi.rc so that A/B OTAs update it. Each trigger
# needs ro.vendor.xp8.layout (2 or later): a layout-1 vendor.img sets none and carries its own copy.
service xp8-gsi /system/bin/xp8-gsi.sh
    class late_start
    user root
    group root
    disabled
    oneshot
    seclabel u:r:su:s0

on property:sys.boot_completed=1 && property:ro.vendor.xp8.layout=*
    start xp8-gsi
    start vendor.xp8-keys

# Side keys (PTT, SOS, camera) as on stock: Sonim's SPCCService, which handled them, is a
# system app the GSI cannot install. Restarted by init if it exits.
service vendor.xp8-keys /system/bin/xp8-keys.sh
    class late_start
    user root
    group root input audio
    disabled
    seclabel u:r:su:s0

# TrebleDroid rw-system.sh (post-fs) masks libpdx_default_transport.so; the stock OMX HAL needs it.
on late-fs && property:ro.vendor.xp8.layout=*
    umount /vendor/lib/libpdx_default_transport.so
    umount /vendor/lib64/libpdx_default_transport.so
    # It also sets 25 media volume steps; stock has Android's 15 (default index 15/3 = 5).
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.config.media_vol_steps 15
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.config.media_vol_default 5

# Applies /system/etc/xp8/vendor-patches to the stock vendor files before the HALs start.
on post-fs && property:ro.vendor.xp8.layout=*
    exec u:r:su:s0 root root -- /system/bin/xp8-vendor-patch.sh

# The 4.4 kernel has RT group scheduling; child cpu groups start with no RT time,
# so SCHED_FIFO requests (SurfaceFlinger, FastMixer) fail. Sum must stay <= 950000.
on post-fs && property:ro.vendor.xp8.layout=*
    write /dev/cpuctl/foreground/cpu.rt_runtime_us 450000
    write /dev/cpuctl/top-app/cpu.rt_runtime_us 200000
    write /dev/cpuctl/system/cpu.rt_runtime_us 100000
    write /dev/cpuctl/rt/cpu.rt_runtime_us 100000

# Magisk su is the only root path (xp8-gsi.sh swaps it into /system/xbin).
on property:init.svc.sudaemon=running && property:ro.vendor.xp8.layout=*
    stop sudaemon

# Android 16 has no HIDL vibrator support; AIDL shim over timed_output.
service vendor.xp8-vibrator /vendor/etc/xp8/xp8-vibrator
    class hal
    user system
    group system
    seclabel u:r:hal_vibrator_default:s0

# update_verifier reboots unless verity is enforcing; this reboot reason makes the ABL leave EIO mode.
on post-fs && property:ro.boot.veritymode=logging && property:ro.vendor.xp8.layout=*
    setprop sys.powerctl "reboot,dm-verity enforcing"
